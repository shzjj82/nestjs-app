{
  "name": "nestjs",
  "version": "0.0.1",
  "description": "NestJS MQTT microservices monorepo (gateway / usercenter / order / docs / upload / wechat / agents / recycle / medical)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build usercenter && nest build order && nest build docs && nest build upload && nest build wechat && nest build agents && nest build recycle && nest build medical",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start:dev": "concurrently -k -n gateway,usercenter,order,docs,upload,wechat,agents,recycle,medical -c cyan,green,yellow,magenta,blue,white,red,gray,greenBright \"nest start gateway --watch\" \"nest start usercenter --watch\" \"nest start order --watch\" \"nest start docs --watch\" \"nest start upload --watch\" \"nest start wechat --watch\" \"nest start agents --watch\" \"nest start recycle --watch\" \"nest start medical --watch\"",
    "start:debug": "nest start gateway --debug --watch",
    "start:admin": "npm --prefix web/admin run dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis mosquitto",
    "infra:down": "docker compose stop postgres redis mosquitto",
    "infra:logs": "docker compose logs -f postgres redis mosquitto",
    "install:db": "bash scripts/infra/install-db.sh",
    "pm2:start": "bash scripts/pm2/start.sh",
    "pm2:stop": "bash scripts/pm2/stop.sh",
    "pm2:restart": "bash scripts/pm2/restart.sh",
    "recycle:start": "bash deploy/recycle/scripts/start.sh",
    "recycle:reload": "bash deploy/recycle/scripts/reload.sh",
    "recycle:bootstrap": "ts-node -T -r tsconfig-paths/register deploy/recycle/scripts/bootstrap.ts",
    "recycle:switch-db": "bash deploy/recycle/db/switch.sh",
    "recycle:docker:up": "docker compose -f deploy/recycle/docker-compose.yml --project-name nestjs-recycle up --build",
    "recycle:docker:down": "docker compose -f deploy/recycle/docker-compose.yml --project-name nestjs-recycle down",
    "medical:start": "bash deploy/medical/scripts/start.sh",
    "medical:reload": "bash deploy/medical/scripts/reload.sh",
    "medical:bootstrap": "ts-node -T -r tsconfig-paths/register deploy/medical/scripts/bootstrap.ts",
    "medical:switch-db": "bash deploy/medical/db/switch.sh",
    "medical:docker:up": "docker compose -f deploy/medical/docker-compose.yml --project-name nestjs-medical up --build",
    "medical:docker:down": "docker compose -f deploy/medical/docker-compose.yml --project-name nestjs-medical down",
    "verify:db": "ts-node -T scripts/infra/verify-database.ts",
    "import:pay-separately": "ts-node -r tsconfig-paths/register scripts/order/import-pay-separately.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.2.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "mqtt": "^5.16.0",
    "multer": "^2.4.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/bill(|/.*)$": "<rootDir>/libs/bill/src/$1"
    }
  }
}
