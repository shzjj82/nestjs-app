# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs
POSTGRES_DB=nestjs
DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/nestjs

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# MQTT / 网关
MQTT_URL=mqtt://127.0.0.1:1883
PORT=3000
# 文档服务写操作：x-docs-key 或登录 JWT
DOCS_SERVICE_KEY=dev-docs-key
# 默认独立库 docs；启动时会自动创建并把旧 doc_* 迁过去
# DOCS_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/docs
# 微信服务独立库 wechat
# WECHAT_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/wechat
# MEDICAL_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/medical
# 本地需要 TypeORM 自动改表时再开（生产不要开）
# TYPEORM_SYNC=true
# 逗号分隔；不填则反射请求 Origin（方便本地 Next.js 管理台）
CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100

# Admin（web/admin Next.js，仅服务端读取；与微服务共用本文件）
GATEWAY_URL=http://127.0.0.1:3000
ADMIN_BIZ_CODE=platform

# 各服务 health 返回的版本号；运维页用来对比是否最新
APP_VERSION=0.0.1
# EXPECTED_APP_VERSION=0.0.1

# 登录会话（Redis Token）
TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# 用户中心种子账号
SEED_APP_CODE=web
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# 改表后若角色唯一约束冲突，本地可临时 TYPEORM_DROP=1 重建表（会清空用户中心数据）
# TYPEORM_DROP=1

# 接入端。用户中心只记 wechatAppId 指向哪套小程序；appId/secret 在微信服务登记
WECHAT_APP_ID=
WECHAT_SECRET=
WECHAT_MP_CODE=wechat
# 生成小程序码是否校验 page 已发布；联调默认 false，上线可改为 true
# WECHAT_QRCODE_CHECK_PATH=false

# 微信支付商家转账（用户确认收款 → package_info → wx.requestMerchantTransfer）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=           # PEM 原文，或 file:/path/to/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_ID=         # 可选，敏感字段加密时需要
# WECHAT_PAY_PUBLIC_KEY=            # 可选，PEM 或 file:
# WECHAT_PAY_API_V3_KEY=            # 可选，回调解密
# WECHAT_TRANSFER_SCENE_ID=         # 商户平台「商家转账」场景 ID，如二手回收
# WECHAT_TRANSFER_NOTIFY_URL=       # 可选，HTTPS 回调
# WECHAT_TRANSFER_USER_RECV_PERCEPTION=回收货款
# WECHAT_TRANSFER_REPORT_INFOS=[{"info_type":"回收商品","info_content":"空墨盒空硒鼓"},{"info_type":"回收说明","info_content":"耗材回收款"}]

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# 上传服务：x-upload-key 或登录 JWT。存储按需配，不随 Docker 默认起 MinIO
UPLOAD_API_KEY=dev-upload-key
# UPLOAD_DRIVER=oss
# UPLOAD_MAX_BYTES=15728640
# UPLOAD_PUBLIC_BASE=https://cdn.example.com

# 自建 MinIO 时再填（UPLOAD_DRIVER=minio）
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=uploads

# 阿里云 OSS（UPLOAD_DRIVER=oss）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# RAG 解析 attachment.fileId（对象键）时拼公开 URL；不填则按 bucket+region 推导
# OSS_PUBLIC_BASE=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# 腾讯云 COS（UPLOAD_DRIVER=cos）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou

# 智能体（密钥只放在 agents 进程；OpenAI 兼容）
# chat（例：DeepSeek）
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# embedding 可单独配（DeepSeek 无 embeddings；通义示例）
# AI_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-v4
# AI_EMBEDDING_DIM=1536
# AI_TIMEOUT_MS=90000
# AGENTS_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/agents
# 网关对同步 chat 的 MQTT 超时（默认 90s）
# AGENTS_MQTT_TIMEOUT_MS=90000
# agents 内部流式 HTTP；网关转发 SSE 时用。多实例时端口从该值递增
# AGENTS_HTTP_PORT=3006
# AGENTS_HTTP_URL=http://127.0.0.1:3006

# 中医诊所微服务（独立库 medical）
# MEDICAL_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/medical
# AUTH_BOOTSTRAP_PASSWORD=tcm123456
# AUTH_SECRET=tcm-dev-auth-secret-change-me
# ID_CARD_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_REASONER_MODEL=qwen-max
# TCM_SKILLS_DIR=

# PM2 副本数。usercenter 默认 1；docs、agents 默认各 3
# USERCENTER_REPLICAS=1
# DOCS_REPLICAS=3
# AGENTS_REPLICAS=3
