# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs
POSTGRES_DB=nestjs
DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/nestjs

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# MQTT / 网关
MQTT_URL=mqtt://127.0.0.1:1883
PORT=3000
# 文档服务写操作：x-docs-key 或登录 JWT
DOCS_SERVICE_KEY=dev-docs-key
# 默认独立库 docs；启动时会自动创建并把旧 doc_* 迁过去
# DOCS_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/docs
# 本地需要 TypeORM 自动改表时再开（生产不要开）
# TYPEORM_SYNC=true
# 逗号分隔；不填则反射请求 Origin（方便本地 Next.js）
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# 登录会话（Redis Token）
TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# 用户中心种子账号
SEED_APP_CODE=web
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# 改表后若角色唯一约束冲突，本地可临时 TYPEORM_DROP=1 重建表（会清空用户中心数据）
# TYPEORM_DROP=1

# 接入端。可登记多套微信 / 支付宝小程序，用 appCode 区分
WECHAT_MOCK=1
WECHAT_APP_ID=
WECHAT_SECRET=
ALIPAY_MOCK=1
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# 上传服务：x-upload-key 或登录 JWT
UPLOAD_API_KEY=dev-upload-key
UPLOAD_DRIVER=minio
# UPLOAD_MAX_BYTES=15728640
# UPLOAD_PUBLIC_BASE=https://cdn.example.com

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# 阿里云 OSS（UPLOAD_DRIVER=oss）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou

# 腾讯云 COS（UPLOAD_DRIVER=cos）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou
