# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs
POSTGRES_DB=nestjs
DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/nestjs

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# MQTT / 网关
MQTT_URL=mqtt://127.0.0.1:1883
PORT=3000
# Next.js 只调文档接口；写操作由对方服务端带 x-docs-key，登录/上传/AI/SEO 不归本仓库
DOCS_SERVICE_KEY=dev-docs-key
# 逗号分隔；不填则反射请求 Origin（方便本地 Next.js）
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# 登录会话（Redis Token）
TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# 用户中心种子账号
SEED_APP_CODE=web
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# 改表后若角色唯一约束冲突，本地可临时 TYPEORM_DROP=1 重建表（会清空用户中心数据）
# TYPEORM_DROP=1

# 接入端。可登记多套微信 / 支付宝小程序，用 appCode 区分
WECHAT_MOCK=1
WECHAT_APP_ID=
WECHAT_SECRET=
ALIPAY_MOCK=1
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
