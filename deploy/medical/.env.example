# ============================================================================
# medical 最小部署 · 环境变量模板
# ============================================================================
# 使用方式：
#   cp deploy/medical/.env.example deploy/medical/.env
#   按下面的说明填值
#   set -a && . ./deploy/medical/.env && set +a
#   npm run medical:bootstrap
#
# ⚠️ 本模板不含任何真实密钥，可以安全提交 git。
#    真实值请写在 deploy/medical/.env（已被 .gitignore 忽略，不可提交）。
# ============================================================================

# ---------- 基础设施 ----------
MQTT_URL=mqtt://127.0.0.1:1883

# 两个服务各连一个库。启动脚本按这两项检测，缺则新建。
# usercenter 进程内部仍读 DATABASE_URL，启动脚本会把本项映射过去。
USERCENTER_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/nestjs
MEDICAL_DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/medical
REDIS_URL=redis://127.0.0.1:6379

# 网关监听端口。AI 对话较慢，超时放到 90s。
PORT=3000
MQTT_TIMEOUT_MS=90000

# ---------- 诊所账号 ----------
# 首次启动会写入 doctor / assistant，默认密码如下（生产务必改掉）。
AUTH_BOOTSTRAP_PASSWORD=tcm123456
AUTH_SECRET=tcm-dev-auth-secret-change-me
# 身份证号 AES-256-GCM 密钥，64 位十六进制。留空则不能保存身份证号。
ID_CARD_KEY=

# 开发期 TypeORM 自动建表；生产建议 false 并改用 migration。
TYPEORM_SYNC=true

# ---------- 对象存储（舌象以外的通用上传走 /upload） ----------
UPLOAD_DRIVER=oss
UPLOAD_API_KEY=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- LLM（通义百炼 OpenAI 兼容） ----------
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_REASONER_MODEL=qwen-max

# Skill 根目录。不填则 medical 进程工作目录下的 skills/（可空）。
# TCM_SKILLS_DIR=/absolute/path/to/TCM_Medical/skills

# ---------- 开通脚本 ----------
MEDICAL_BIZ_CODE=medical
MEDICAL_BIZ_NAME=中医诊所
MEDICAL_ROLES=doctor,assistant
MEDICAL_CLIENT_CODE=medical
# MEDICAL_EXTRA_APIS=POST /upload
MEDICAL_BOOTSTRAP_TIMEOUT_MS=15000
# MEDICAL_BOOTSTRAP_DRY_RUN=1

# ---------- 可选 ----------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3100,http://127.0.0.1:3100
TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000
