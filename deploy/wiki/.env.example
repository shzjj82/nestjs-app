# ============================================================================
# wiki 业务开通 · 环境变量模板
# ============================================================================
# 使用方式：
#   cp deploy/wiki/.env.example deploy/wiki/.env
#   填好 MQTT_URL 后：
#   set -a && . ./deploy/wiki/.env && set +a
#   npm run wiki:bootstrap
#
# 真实密钥写在 deploy/wiki/.env（已被 .gitignore 忽略）。
# ============================================================================

# 微服务总线
MQTT_URL=mqtt://127.0.0.1:1883

# 业务标识（编辑器 X-Biz-Code / X-App-Code 均为 wiki）
WIKI_BIZ_CODE=wiki
WIKI_BIZ_NAME=Wiki 编辑器

# 额外要开通的接口白名单，逗号分隔（`POST /xxx` 形式）。一般不用填。
# WIKI_EXTRA_APIS=

# 单次 MQTT 调用超时（毫秒）
WIKI_BOOTSTRAP_TIMEOUT_MS=15000

# 设为 1 时只打印计划、不落库
# WIKI_BOOTSTRAP_DRY_RUN=1
