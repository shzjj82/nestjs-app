# ============================================================================
# recycle 最小部署 · 环境变量模板
# ============================================================================
# 使用方式：
#   cp .env.recycle.example .env.recycle
#   按下面的说明填值
#   set -a && . ./.env.recycle && set +a      # 导入当前 shell
#   npx ts-node -r tsconfig-paths/register scripts/recycle-bootstrap.ts
#
# ⚠️ 本模板不含任何真实密钥，可以安全提交 git。
#    真实值请写在 .env.recycle（已被 .gitignore 忽略，不可提交）。
#
# 【重要】小程序的真实参数不在环境变量里，而在生产库 wx_miniprograms 表：
#   生产上 recycle 业务的记录是  code=recycle / name=墨盒回收 / app_id=wx6cb642a406f7f651
#   secret 与 subscribe_templates 都存在该表里（不是 .env 的 WECHAT_APP_ID，
#   后者是给 wechat 服务启动自登记用的，生产上一直是空的）。
#   迁移新环境时，最省事的做法是直接从旧库导出这条记录：
#     psql -d wechat -tA -c "SELECT secret, subscribe_templates FROM wx_miniprograms WHERE code='recycle'"
# ============================================================================

# ---------- 基础设施 ----------
# MQTT 服务总线，微服务之间全靠它通信；客户端不直连各服务
MQTT_URL=mqtt://127.0.0.1:1883

# 用户中心主库（uc_* 表）。recycle / wechat 的库名会由它自动推导：
#   DATABASE_URL 把库名换成 recycle -> RECYCLE_DATABASE_URL
#   DATABASE_URL 把库名换成 wechat  -> WECHAT_DATABASE_URL
# 需要显式覆盖时再单独写这两个变量。
DATABASE_URL=postgres://nestjs:nestjs@127.0.0.1:5432/nestjs
REDIS_URL=redis://127.0.0.1:6379

# 网关监听端口
PORT=3000

# ---------- 回收服务内部密钥 ----------
# recycle 内部各模块（orders <-> approvals）之间互相调用的凭证。
# 千万别用默认的 dev-recycle-internal-key，随便生成一个：
#   openssl rand -hex 32
RECYCLE_INTERNAL_KEY=

# ---------- 微信小程序 ----------
# ⚠️ 这里的 WECHAT_MP_CODE 必须是 recycle：本表 code 就是业务 code，
#    回收业务与小程序 1:1，服务按「业务 code」去 wx_miniprograms 里查自己的配置。
#    默认值 'wechat' 是平台默认小程序的 code，回收业务不能用它。
WECHAT_MP_CODE=recycle
WECHAT_MP_NAME=墨盒回收

# 小程序凭证。appId 来自平台公开信息可以直接填；
# secret 是敏感值，从生产库取：SELECT secret FROM wx_miniprograms WHERE code='recycle'
WECHAT_APP_ID=wx6cb642a406f7f651
WECHAT_SECRET=

# ---------- 对象存储（实物照片） ----------
# 生产用的是阿里云 OSS（UPLOAD_DRIVER=oss）。
# 本地没有 OSS 时可以改成 minio 并配 MINIO_*，或临时用 local。
UPLOAD_DRIVER=oss
UPLOAD_API_KEY=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=championsea
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 开通脚本用的参数 ----------
# 业务标识与名称（开通脚本 +X-Biz-Code 都用它）
RECYCLE_BIZ_CODE=recycle
RECYCLE_BIZ_NAME=回收

# 需要额外创建的身份角色，逗号分隔。
#   注意 customer（客户）由 business.create 自动创建，不要写在这里，否则会 409。
#   agent = 业务员（作业全流程）；admin = 超管。
RECYCLE_ROLES=agent,admin

# 订阅消息模板：4 个回收场景，键是场景名，值是 {"templateId":"...","fields":{...}}
#   fields 的**值**必须是这 5 个语义之一，写错会被服务端 400 拒绝：
#   orderCode / title / statusLabel / amount / at
#   fields 的**键**是微信模板里的字段名（如 character_string1、amount3）
#
# 快速填充：从生产库导出后 JSON 化即可
#   psql -d wechat -tA -c "SELECT subscribe_templates FROM wx_miniprograms WHERE code='recycle'"
# 不填也可以先跑通业务，只是收不到订阅消息；后台申请到模板后再重跑开通脚本补写。
RECYCLE_SUBSCRIBE_TEMPLATES='{"PRICE_OFFERED":{"templateId":"","fields":{"character_string1":"orderCode","phrase2":"statusLabel","amount3":"amount"}},"NEGOTIATE_RESULT":{"templateId":"","fields":{"character_string1":"orderCode","phrase2":"statusLabel","amount3":"amount"}},"PAID":{"templateId":"","fields":{"character_string1":"orderCode","amount2":"amount","phrase3":"statusLabel"}},"RETURN":{"templateId":"","fields":{"character_string1":"orderCode","phrase2":"statusLabel","thing3":"title"}}}'

# 额外要开通的接口白名单，逗号分隔（`POST /xxx` 形式）。
# 开通脚本默认已经按「功能点目录里的 recycle.*」+ 回收必需的 auth/wechat/upload
# 推导过了，一般不用填。只有临时想放开某个接口时才写。
# RECYCLE_EXTRA_APIS=GET /recycle/logistics/:no

# 单次 MQTT 调用超时（毫秒）
RECYCLE_BOOTSTRAP_TIMEOUT_MS=15000

# 设为 1 时开通脚本只打印将要做什么，不落库。建议第一次先跑一遍看看。
# RECYCLE_BOOTSTRAP_DRY_RUN=1

# ---------- 可选 ----------
# 网关 CORS，填 admin 前端地址。多个用逗号分隔。
CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100

# 登录态有效期
TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# usercenter 副本数，默认 1
USERCENTER_REPLICAS=1
